# Copy this to .env and adjust as needed. No passwords belong in this file.
# Toolset: minimal or full.
MODE=full
# Desktop: no, openbox, or xfce-kali. Independent from MODE.
DESKTOP=openbox
# Optional name for an existing Docker network used with compose.bridge.yaml.
KALI_DOCKER_NETWORK=kali-lab-bridge
INSTALL_MALTEGO=false
# Runtime timezone (IANA name, for example Europe/Rome).
TZ=Etc/UTC
# Runtime UTF-8 locale (for example it_IT.UTF-8).
LANG=C.UTF-8
# Optional Compose secret inputs. Leave blank when the selected profile does not need them.
# Export these variables in the shell running Compose when required; keep passwords out of .env.
KALI_PASSWORD=
POSTGRES_PASSWORD=
