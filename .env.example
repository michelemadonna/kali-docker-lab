# Optional build profiles: network,web,ad,exploitation,osint,wireless.
# CLI selectors and --gui are valid only with --build. --minimal ignores PROFILES.
PROFILES=
# Optional desktop for builds: no, openbox, or xfce-kali.
# Empty defaults to openbox for profile builds; --minimal stays bare if empty.
DESKTOP=
# Runtime timezone (IANA name, for example Europe/Rome).
TZ=Etc/UTC
# Runtime UTF-8 locale (for example it_IT.UTF-8).
LANG=C.UTF-8
# Default Docker bridge network used by --network bridge; kali.sh creates it if missing.
KALI_DOCKER_NETWORK=kali-lab-bridge
